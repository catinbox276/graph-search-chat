    <diagram id="comp-pipeline" name="5 그래프 파이프라인 (graph_pipeline.py)">
        <mxGraphModel dx="1765" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="그래프 파이프라인 — 게이트 2갈래 · 추출 · 재발 소급 취소 (야간 03:00)" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="225" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="src" value="sessions (verdict IS NULL)&#10;UI 세션 포함 미판정분" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="490" y="70" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="branch" value="태스크 세션?&#10;(tasks.yaml에 id 있음)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="530" y="170" width="190" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="taskj" value="LLM 게이트 판정 (JUDGE_PROMPT)&#10;expect 기준 success / fail / unknown&#10;+ 도메인 추출 지침 주입" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="210" y="320" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sigj" value="행동 신호 게이트 (코드 판정 — judge_by_signals)&#10;즉시 fail: 명시적 실패 인정 (&quot;찾지 못했습니다&quot; 등)&#10;후퇴: 재질문·정정 언어·문서 재방문·조급함&#10;전진: 구체화·화제 전진·조용한 종료&#10;후퇴≥2 → fail / 전진만 → success / 나머지 → 미판정&#10;금지: 감정 분석 · &quot;그만 물음=성공&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="640" y="290" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="verdict" value="verdict?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="560" y="470" width="130" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="unk" value="❓ unknown&#10;그래프에 안 씀&#10;(원본 로그만 증거 보관)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="470" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="dom" value="1층 도메인 분류 — domain_registry 대조&#10;(도구 사용으로 결정적, priority 순 · 폴백=최하순위)&#10;extract_hint를 추출 프롬프트에 주입" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="430" y="590" width="390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="extract" value="4계층 추출·병합 (get_or_create)&#10;1층 도메인(결정적) → 2층 목표·3층 접근법(LLM)&#10;→ 4층 행동(tool_calls에서 결정적)&#10;dedup: 코사인 ≥0.92 즉시 병합 / 0.70~0.92 LLM 확인&#10;실패 세션 → 접근법에 fail_flag + 이유&#10;출처: node_evidence(node, session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="430" y="710" width="390" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="retract" value="재발 소급 취소 (retract_recurrences)&#10;success 세션과 첫 질문 유사(≥0.85) 세션이&#10;RECUR_DAYS(7일) 안에 다시 오면&#10;verdict='retracted' + 기여 가중치 회수&#10;(노드·증거 보존 — 성공 카운트에서만 빠짐)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="430" y="880" width="390" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="wgt" value="가중치 보정 (recompute_weights)&#10;노출 대비 채택률 반영 — 피드백 루프 차단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1030" width="310" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="src" target="branch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="예 (selfplay)" style="endArrow=block;html=1;strokeWidth=2;fontSize=10;" parent="1" source="branch" target="taskj" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="아니오 (UI)" style="endArrow=block;html=1;strokeWidth=2;fontSize=10;" parent="1" source="branch" target="sigj" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="taskj" target="verdict" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="sigj" target="verdict" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="success / fail" style="endArrow=block;html=1;strokeWidth=2;fontSize=10;" parent="1" source="verdict" target="dom" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="unknown" style="endArrow=block;html=1;strokeWidth=1;dashed=1;fontSize=10;" parent="1" source="verdict" target="unk" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="dom" target="extract" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="extract" target="retract" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="retract" target="wgt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="comp-maint" name="6 유지보수 (graph_maintenance.py)">
        <mxGraphModel dx="1765" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="그래프 유지보수 — 3패스, 멱등 (야간 03:20)" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="325" y="20" width="600" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="패스 1 — 형제 통합&#10;같은 부모 밑 저빈도(통행≤2) 노드가&#10;인기 형제와 유사하면(코사인≥0.70&#10;+ LLM 동일 의도 확인) 흡수&#10;→ 과분리 사후 교정&#10;가중치·출처는 형제로 합산" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="100" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="패스 2 — 잎 흡수&#10;생성 후 14일 지나도 통행≤1인&#10;3층 말단을 부모(목표)로 흡수&#10;→ 장기 비대화 방지&#10;고아가 된 4층 도구 노드 함께 정리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="460" y="100" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="패스 3 — 시간 감쇠 (신규)&#10;유예 30일 넘게 통행 없는 3층 접근법의&#10;weight를 반감기 90일 곡선으로 하강&#10;바닥 0.1 밑으론 안 내려감 (삭제 금지)&#10;멱등: raw_count·채택률로 기준치 재계산 후&#10;감쇠 배수 곱 — 반복 실행해도 겹감쇠 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="840" y="100" width="340" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="why" value="근거: AWM 표11 — 분포가 다른 낡은 워크플로우가 새 것을 훼손 (4.8 → 1.6)&#10;원칙: 낡은 건 지우지 말고 가라앉힌다. 신선도는 원인이 아니라 조치(접근법)에 붙는다 (design §2 운영 규칙 5)" style="text;html=1;fontSize=11;align=left;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="80" y="290" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ora" value="Oracle&#10;nodes · edges · node_evidence · suggestions · sessions(ts)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="400" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=1;" parent="1" source="p1" target="ora" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=1;" parent="1" source="p2" target="ora" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=1;" parent="1" source="p3" target="ora" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="comp-storage" name="7 저장소 (Oracle 테이블 맵)">
        <mxGraphModel dx="1765" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="저장소 — Oracle 단일 DB 테이블 맵 (만든 곳 → 쓰는 곳)" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="225" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="blog" value="blog_posts&#10;노하우 코퍼스 + embedding BLOB&#10;생산: load_oracle·embed_corpus / 소비: 검색" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="90" width="330" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sess" value="sessions (id, turn, ts, 질문·툴호출·답변, verdict)&#10;verdict: success / fail / unknown / retracted&#10;생산: server(턴 기록)·selfplay / 소비: 파이프라인·경로제안" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="460" y="90" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="graphT" value="nodes / edges / node_evidence&#10;4계층 그래프 + 가중치(raw_count·weight) + 출처&#10;nodes: fail_flag·fail_reason·valid_from/to (bi-temporal)&#10;생산: 파이프라인·유지보수 / 소비: 경로제안·그래프뷰" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="210" width="360" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sugg" value="suggestions (problem, node_id, session_id, adopted)&#10;경로 제안 노출 기록 — 채택률 보정의 원료&#10;생산: path_suggest / 소비: 파이프라인·감쇠" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="490" y="210" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dreg" value="domain_registry (name, tools, priority, extract_hint)&#10;1층 닫힌 목록 + 도메인별 추출 지침&#10;생산: 관리자 API·UI(사람 전용) / 소비: 파이프라인 분류" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="350" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="mreg" value="model_registry (kind, name, enabled, is_default)&#10;LLM=사용자 선택 / 임베딩·리랭커=관리자&#10;생산: 관리자 API / 소비: server·검색" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="490" y="350" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="lg" value="lg_checkpoints / lg_writes&#10;LangGraph 멀티턴 기억 외부화 (thread=세션)&#10;생산·소비: OracleSaver (복제본 공유·재시작 생존)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="880" y="210" width="330" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="rule" value="원칙 (design §5): Oracle 19c 단독 — 별도 벡터DB·검색엔진 금지.&#10;벡터 검색 대체 = 진입점 LLM/임베딩 분류(닫힌 상위층) + 애플리케이션 브루트포스 dedup.&#10;그래프는 원본(sessions)에서 재생성 가능한 파생 데이터 — 접속 상수는 tools/blog_search.py에서 import가 관례." style="text;html=1;fontSize=11;align=left;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="80" y="490" width="900" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="추출" style="endArrow=block;html=1;strokeWidth=1;fontSize=10;" parent="1" source="sess" target="graphT" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="채택 판정" style="endArrow=block;html=1;strokeWidth=1;fontSize=10;" parent="1" source="sugg" target="graphT" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="1층 분류" style="endArrow=block;html=1;strokeWidth=1;fontSize=10;" parent="1" source="dreg" target="graphT" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
