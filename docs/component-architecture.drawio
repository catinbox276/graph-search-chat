    <diagram id="comp-suggest" name="4 경로 제안 (path_suggest.py)">
        <mxGraphModel dx="1765" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="750" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="경로 제안 — 검증 경로 추천 + 실패 경고 (tools/path_suggest.py)" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="225" y="20" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p" value="사용자 문제 한 문장&#10;(suggest_paths 호출)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="120" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="entry" value="진입점: 문제 임베딩 ↔ 2층(목표) 노드&#10;브루트포스 코사인 ≥ 0.60, 상위 3개" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="120" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="walk" value="목표 → 3층 접근법 (보정 가중치 내림차순)&#10;성공/실패는 세션 판정 카운트로 집계&#10;(verdict='success' / 'fail' — retracted는 자동 제외)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="720" y="110" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ok" value="✅ 검증된 경로 (성공 N회)&#10;+ 사용 도구(4층) 안내" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="620" y="280" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="warn" value="⚠ 실패 우세 접근 (실패&gt;성공일 때만)&#10;실패 이유와 함께 경고 — 하드 차단 금지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="900" y="280" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="expose" value="노출 기록: suggestions 테이블&#10;(problem, node_id, session_id, adopted)&#10;→ 파이프라인이 채택 여부 판정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="280" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="loop" value="피드백 루프 보정 (recompute_weights)&#10;weight = 자발 통행 + 채택 통행 × 채택률&#10;— &quot;많이 보여준 길 = 좋은 길&quot; 왜곡 차단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="360" y="430" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="empty" value="유사 목표 없음 →&#10;&quot;자유롭게 접근하세요&quot; (새 경로로 축적)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
