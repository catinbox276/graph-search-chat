                    <mxGeometry x="80" y="170" width="740" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="app" value="gsc-app (Deployment, :8500)&#10;모놀리스 이미지: 앱+에이전트+배치 공용&#10;harbor.quantumcns.ai/user-dalgo/graph-search-chat&#10;envFrom: gsc-env ConfigMap (gsc.env 1파일)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
