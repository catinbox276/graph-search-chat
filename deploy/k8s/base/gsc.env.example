# k8s 배포용 환경설정 템플릿 — 복사해서 gsc.env로 쓰고 값을 채운다.
#   cp deploy/k8s/base/gsc.env.example deploy/k8s/base/gsc.env
# kustomization.yaml의 configMapGenerator가 gsc.env를 읽어 ConfigMap을 만든다(envFrom 주입).
# gsc.env는 사내 클러스터 DNS·모델 코드명·크리덴셜이 들어가므로 .gitignore 대상(커밋 금지).
# 로컬 개발용 .env와는 별개 파일. PASSWORD/SECRET류는 사내 전환 시 Secret + secretGenerator로 분리.

# --- Oracle (파드 간 서비스 DNS) ---
ORACLE_DSN=oracle:1521/<PDB_SERVICE>        # 예: FREEPDB1(23-free) / XEPDB1(18-xe) / 사내 19c 서비스명
ORACLE_USER=system
ORACLE_PASSWORD=<change-me>
# 드라이버 모드: thick=Instant Client 사용(이미지에 포함) / thin=순수 파이썬
ORACLE_MODE=thick
ORACLE_CLIENT_LIB_DIR=

# --- 모델 서빙 (클러스터 내부 predictor DNS — 외부 인그레스 아님) ---
# 실제 값은 각 서빙의 predictor ClusterIP DNS + GET /v1/models 의 served-model-name.
MODEL_API_KEY=dummy                         # vLLM에 --api-key 미설정 시 더미값
CHAT_URL=http://<llm-predictor-svc>/v1
MODEL_NAME=<served-model-name>
EMBED_URL=http://<embedding-predictor-svc>/v1
EMBED_MODEL=<served-model-name>
RERANK_URL=http://<reranker-predictor-svc>/v1
RERANK_MODEL=<served-model-name>

# --- DataHub ---
DATAHUB_GMS_URL=http://<datahub-gms-svc>:8080

# --- 인증 (자체 계정 — web/auth.py, docs/integration.md) ---
# 관리자는 env 계정 1개. 일반 계정은 /login 가입 → 관리 페이지 승인 후 로그인.
# ADMIN_PASSWORD·SESSION_SECRET 비면 기동 실패(fail-fast).
ADMIN_ID=admin
ADMIN_PASSWORD=<change-me>                   # Secret 분리 대상
SESSION_SECRET=<change-me>                   # 로그인 토큰 서명키 — Secret 분리 대상
SESSION_MAX_AGE=28800                        # 로그인 토큰 수명(초)

# --- 검색 백엔드 (docs/inmemory-search-graph.md) ---
# oracle=Oracle Text(CONTAINS)+메모리 행렬 (Oracle Text 권한 필요: CTXAPP + CTX_DDL)
# inmemory=SQLite FTS5+sqlite-vec (Oracle Text 권한 불필요)
SEARCH_ENGINE=oracle
ORACLE_TEXT_LEXER=WORLD_LEXER                # oracle 엔진일 때 (KOREAN_MORPH_LEXER=한국어 정밀)

# --- 활동 로그 ---
EVENTS_RETAIN_DAYS=180                        # 이 일수 지난 로그는 야간 유지보수가 회전 삭제

# --- 원천 테이블 접근 제어 (쉼표구분, 빈값=제한 없음) ---
SOURCE_TABLE_ALLOWLIST=

# --- 도구 서버 기본 등록 (env만으로 시드 — 사내 REST 도구 서버는 TRANSPORT=rest) ---
#MCP_DEFAULT_NAME=datahub
#MCP_DEFAULT_URL=http://<사내-도구서버-svc>
#MCP_DEFAULT_TRANSPORT=rest

# 튜닝 옵션(RRF_K, DEDUP_SIM_*, DOC_*, CHUNK_* 등)은 코드 기본값 사용 — .env.example 참조.
# 바꾸려면 여기 KEY=VALUE로 추가하면 ConfigMap 해시가 바뀌어 롤링 재시작까지 자동.
