# k8s 배포용 환경설정 템플릿 — 복사해서 gsc.env로 쓰고 값을 채운다.
#   cp k8s/base/gsc.env.example k8s/base/gsc.env
# kustomization.yaml의 configMapGenerator가 gsc.env를 읽어 ConfigMap을 만든다(envFrom 주입).
# gsc.env는 사내 클러스터 DNS·모델 코드명·크리덴셜이 들어가므로 .gitignore 대상(커밋 금지).
# 로컬 개발용 .env와는 별개 파일.

# --- Oracle (파드 간 서비스 DNS) ---
ORACLE_DSN=oracle:1521/<PDB_SERVICE>        # 예: FREEPDB1(23-free) / XEPDB1(18-xe) / 사내 19c 서비스명
ORACLE_USER=system
ORACLE_PASSWORD=<change-me>                 # 사내 전환 시 Secret + secretGenerator로 분리
# 드라이버 모드: thick=Instant Client 사용(이미지에 포함) / thin=순수 파이썬
ORACLE_MODE=thick
ORACLE_CLIENT_LIB_DIR=

# --- 모델 서빙 (클러스터 내부 predictor DNS — 외부 인그레스 아님) ---
# 실제 값은 각 서빙의 predictor ClusterIP DNS + GET /v1/models 의 served-model-name.
MODEL_API_KEY=dummy                         # vLLM에 --api-key 미설정 시 더미값
CHAT_URL=http://<llm-predictor-svc>/v1
MODEL_NAME=<served-model-name>
EMBED_URL=http://<embedding-predictor-svc>/v1
EMBED_MODEL=<served-model-name>
RERANK_URL=http://<reranker-predictor-svc>/v1
RERANK_MODEL=<served-model-name>

# --- DataHub / 관리 ---
DATAHUB_GMS_URL=http://<datahub-gms-svc>:8080
ADMIN_TOKEN=<change-me>

# --- 인증 (SSO — docs/integration.md 접점 1) ---
# 사내 기본은 header: 전단 SSO가 주입하는 userId·role 헤더 2개만 소비 (아래 KEYCLOAK_*·
# OIDC_CLIENT_* 불필요, OIDC_ADMIN_ROLE만 유효). keycloak은 전단 없는 데모·검증용
# (k8s/keycloak.yaml PoC 파드와 짝).
AUTH_MODE=header                            # none이면 인증 비활성
SSO_USER_HEADER=X-Auth-Request-User         # 전단 SSO의 userId 헤더명 (협의값)
SSO_ROLE_HEADER=X-Auth-Request-Groups       # 전단 SSO의 role 헤더명 (협의값)
KEYCLOAK_PUBLIC_URL=http://<외부-keycloak-url>   # 브라우저 리다이렉트용
KEYCLOAK_INTERNAL_URL=http://<클러스터내부-keycloak>:8080/auth  # 토큰 교환용(비면 PUBLIC)
KEYCLOAK_REALM=<realm>
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<change-me>              # Secret 분리 대상
OIDC_ADMIN_ROLE=gsc-admin                   # 이 realm 역할 보유 시 관리자
APP_BASE_URL=http://<앱-외부-url>            # OIDC redirect_uri 기준
SESSION_SECRET=<change-me>                  # 로그인 쿠키 서명키 — Secret 분리 대상

# 튜닝 옵션(RRF_K, DEDUP_SIM_* 등)은 코드 기본값 사용. 바꾸려면 여기 KEY=VALUE로 추가.
