# graph-search-chat 환경설정 템플릿 — 복사해서 .env로 쓰고 값을 채운다.
#   cp .env.example .env
# src/core/config.py가 기동 시 레포 루트의 .env를 로드한다. 우선순위: 실제 환경변수 > .env > 코드 기본값.
# 값이 비면 CHAT/EMBED/RERANK_URL은 단일 MODEL_URL로 폴백한다(LM Studio 단일 서빙 호환).
# 실행은 repo 루트에서 PYTHONPATH=src (예: PYTHONPATH=src .venv/bin/uvicorn web.server:app).

# === Oracle 18c/19c ===
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=system
ORACLE_PASSWORD=change-me
# thin=순수파이썬(기본, Instant Client 불필요) / thick=Instant Client 필요(lib_dir 지정 시)
ORACLE_MODE=thin
ORACLE_CLIENT_LIB_DIR=

# === 모델 서빙 (OpenAI 호환) ===
# 로컬(LM Studio 단일 서빙)이면 MODEL_URL 하나만 두고 아래 역할별 URL은 비워도 된다.
#MODEL_URL=http://127.0.0.1:1234/v1
MODEL_API_KEY=dummy
# 사내 vLLM은 모델마다 호스트가 다르므로 역할별로 지정.
# served-model-name은 각 호스트의 GET /v1/models 로 확인 후 정확히 기입.
CHAT_URL=http://<llm-host>/v1
MODEL_NAME=<served-model-name>
EMBED_URL=http://<embedding-host>/v1
EMBED_MODEL=<served-model-name>
RERANK_URL=http://<reranker-host>/v1
RERANK_MODEL=<served-model-name>
# 실사용 임베딩·리랭커 기본값은 관리 페이지의 model_registry가 우선(위 값은 폴백).

# === DataHub (배치 적재 전용 — ingestion/ingest_bird.py 같은 시드 스크립트) ===
# 에이전트의 DataHub 연결은 GMS 직결이 아니라 MCP-over-REST (아래 MCP_DEFAULT_* 또는 관리 페이지)
#DATAHUB_GMS_URL=http://localhost:8080

# === 에이전트 정체성·지원 범위 (시스템 프롬프트에 주입) ===
#AGENT_NAME=지식그래프 챗
#AGENT_INTRO=사내 데이터와 지식 검색을 돕는 어시스턴트입니다   # 빈값=이름 기반 기본 문구
#AGENT_SCOPE=사내 데이터(테이블·스키마·조인·리니지) 조회, 사내 노하우·문제해결 지식 검색

# === 인증 (자체 계정 — web/auth.py) ===
# 관리자는 이 env 계정 1개 (DB 아님 — env 수정으로 복구 가능).
# 일반 계정은 /login에서 가입(id+pw) → 관리 페이지에서 승인해야 로그인 가능.
ADMIN_ID=admin
ADMIN_PASSWORD=change-me                         # 비어 있으면 기동 실패 (필수)
SESSION_SECRET=change-me                         # 로그인 토큰 서명키 (필수)
SESSION_MAX_AGE=28800                            # 로그인 토큰 수명(초)

# === 검색 (SQLite 인메모리 — FTS5 + sqlite-vec, Oracle Text 권한 불필요) ===
INMEM_RELOAD_SECS=60                             # 인메모리 인덱스 버전 확인 주기(초)

# === 활동 로그 (app_events — 정상·비정상 전부 기록) ===
EVENTS_RETAIN_DAYS=180                            # 이 일수 지난 로그는 야간 유지보수가 회전 삭제

# === 원천 테이블 접근 제어 ===
# 소스 등록·조회·적재를 이 목록의 테이블로만 제한 (쉼표구분, 빈값=제한 없음). 사내 전환 시 허용분만 나열.
SOURCE_TABLE_ALLOWLIST=

# === 도구 서버 기본 등록 (env만으로 시드 — 이후 관리 페이지에서 수정/비활성) ===
# 사내 REST 도구 서버(GET /tools + POST /call)는 TRANSPORT=rest 로.
#MCP_DEFAULT_NAME=datahub
#MCP_DEFAULT_URL=http://사내-도구서버-호스트
#MCP_DEFAULT_TRANSPORT=rest

# ===================================================================
# 튜닝 옵션 (생략 시 코드 기본값 — 아래는 현재 기본값과 동일, 바꿀 때만)
# ===================================================================
LLM_TEMPERATURE=0.0

# 하이브리드 검색 (RRF 융합)
RRF_K=60
SEARCH_TOP_LEXICAL=30
SEARCH_TOP_SEMANTIC=30

# 경로 제안 진입점 매칭 (search/path_suggest.py)
PATH_SIM_ENTRY=0.60

# 그래프 dedup 병합 임계값 (graph/graph_pipeline.py)
DEDUP_SIM_HIGH=0.92                               # 이상이면 LLM 확인 없이 즉시 병합
DEDUP_SIM_THRESHOLD=0.70                          # 후보 하한(이 구간은 LLM 확인)
DEDUP_SHORT_NAME_CHARS=12                         # 미만 짧은 이름은 자동 병합 제외 → LLM
DEDUP_CHAR_RATIO=0.4                              # difflib 문자 유사도 하한
DEDUP_SELECT_MAX=8                                # LLM 후보 선택에 넣는 최대 후보 수
LLM_AUX_NO_THINK=1                                # 보조 LLM 판정(같음/다름)에서 생각 끄기

# 그래프 유지보수 (graph/graph_maintenance.py)
MAINT_LOW_COUNT=2
MAINT_ABSORB_COUNT=1
MAINT_MIN_AGE_DAYS=14
# 시간 감쇠 (패스3) — 유예 지나면 반감기 곡선으로 가라앉힘, 하한 미만으론 안 내려감
MAINT_DECAY_HALF_LIFE_DAYS=90
MAINT_DECAY_GRACE_DAYS=30
MAINT_DECAY_FLOOR=0.1

# 세션 게이트 행동 신호 (graph/graph_pipeline.py)
SIG_REPEAT_SIM=0.85                               # 재질문·재발 판정 질문 유사도
SIG_TOPIC_MOVE_SIM=0.50                           # 이보다 멀어지면 화제 전진
SIG_HASTY_RATIO=0.3                               # 턴 간격이 중앙값의 이 배수 미만이면 조급함
SEG_SPLIT_SIM=0.35                                # 인접 질문이 이보다 멀면 태스크 경계로 분할
RECUR_DAYS=7                                       # 재발 판정 창(일)

# 문서 그래프 구조화 (graph/doc_pipeline.py) — 운영은 app_settings(관리 UI)가 우선
DOC_EXTRACT_LIMIT=200                             # 실행당 처리 문서 수
DOC_CONCURRENCY=16                                # LLM 판정 동시 요청 수
DOC_BODY_CHARS=3000                               # 판정에 넣는 본문 길이(자)
DOC_PACK_TOKENS=0                                 # 0=1건씩 / N=입력 N토큰 예산으로 묶음 판정
DOC_NO_THINK=1                                     # 1=판정 시 생각 끄기(실측 7~8배 빠름)

# 청킹 (ingestion/chunk_corpus.py) — 운영은 app_settings 우선
CHUNK_CHARS=1200
CHUNK_OVERLAP=150

# 임베딩 백필 (ingestion/embed_corpus.py)
EMBED_BATCH=64
EMBED_CONCURRENCY=4
EMBED_TEXT_CHARS=300

# 코퍼스 빌드 (ingestion/build_corpus.py) — 0=전체
CORPUS_TOP_N=0

# Oracle 커넥션 풀 (전 모듈 공통)
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
