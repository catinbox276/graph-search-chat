# graph-search-chat 환경설정 템플릿 — 복사해서 .env로 쓰고 값을 채운다.
#   cp .env.example .env
# tools/config.py가 기동 시 .env를 로드한다. 우선순위: 실제 환경변수 > .env > 코드 기본값.
# 값이 비면 CHAT/EMBED/RERANK_URL은 단일 MODEL_URL로 폴백한다(LM Studio 단일 서빙 호환).

# === Oracle 19c ===
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=system
ORACLE_PASSWORD=change-me

# === 모델 서빙 (OpenAI 호환) ===
# 로컬(LM Studio 단일 서빙)이면 MODEL_URL 하나만 두고 아래 역할별 URL은 비워도 된다.
# MODEL_URL=http://127.0.0.1:1234/v1
MODEL_API_KEY=dummy

# 사내 vLLM은 모델마다 호스트가 다르므로 역할별로 지정.
# served-model-name은 각 호스트의 GET /v1/models 로 확인 후 정확히 기입.
CHAT_URL=http://<llm-host>/v1
MODEL_NAME=<served-model-name>
EMBED_URL=http://<embedding-host>/v1
EMBED_MODEL=<served-model-name>
RERANK_URL=http://<reranker-host>/v1
RERANK_MODEL=<served-model-name>

# === DataHub / 관리 ===
DATAHUB_GMS_URL=http://localhost:8080

# === 인증 (SSO — app/auth.py, docs/integration.md 접점 1) ===
# none=인증 없음(로컬 개발 기본) / header=전단 SSO 헤더 소비(사내 기본) /
# keycloak=앱이 직접 OIDC 코드 플로우(전단 없는 환경). k8s 값은 k8s/base/gsc.env.
AUTH_MODE=none
# header 모드: 전단 SSO가 주입하는 헤더명 2개만 맞추면 끝 (userId 필수, role 선택)
SSO_USER_HEADER=X-Auth-Request-User
SSO_ROLE_HEADER=X-Auth-Request-Groups
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth   # 브라우저 리다이렉트용
KEYCLOAK_INTERNAL_URL=                           # 토큰 교환용 — 비면 PUBLIC 사용
KEYCLOAK_REALM=gsc
OIDC_CLIENT_ID=gsc-app
OIDC_CLIENT_SECRET=change-me
OIDC_ADMIN_ROLE=gsc-admin                        # 이 역할 보유 시 관리자 (header·keycloak 공통)
APP_BASE_URL=http://localhost:8500               # OIDC redirect_uri 기준
SESSION_SECRET=change-me                         # 로그인 쿠키 서명키
SESSION_MAX_AGE=28800                            # 로그인 쿠키 수명(초)

# === 튜닝 옵션 (생략 시 코드 기본값 — 아래는 현재 기본값과 동일) ===
LLM_TEMPERATURE=0.0
# 하이브리드 검색
RRF_K=60
SEARCH_TOP_LEXICAL=30
SEARCH_TOP_SEMANTIC=30
# 경로 제안 진입점 매칭
PATH_SIM_ENTRY=0.60
# 그래프 dedup 병합 임계값
DEDUP_SIM_HIGH=0.92
DEDUP_SIM_THRESHOLD=0.70
# 그래프 유지보수
MAINT_LOW_COUNT=2
MAINT_ABSORB_COUNT=1
MAINT_MIN_AGE_DAYS=14
# 시간 감쇠 (유지보수 패스3) — 유예 지나면 반감기 곡선으로 가라앉힘, 하한 미만으론 안 내려감
MAINT_DECAY_HALF_LIFE_DAYS=90
MAINT_DECAY_GRACE_DAYS=30
MAINT_DECAY_FLOOR=0.1
# 실서비스 게이트 행동 신호 (파이프라인) — 재질문·재발 유사도 / 화제 전진 / 조급함 / 재발 창(일)
SIG_REPEAT_SIM=0.85
SIG_TOPIC_MOVE_SIM=0.50
SIG_HASTY_RATIO=0.3
RECUR_DAYS=7
# 임베딩 백필
EMBED_BATCH=64
EMBED_CONCURRENCY=4
EMBED_TEXT_CHARS=300
# 코퍼스 빌드 (0=전체)
CORPUS_TOP_N=0
# Oracle 커넥션 풀 (전 모듈 공통)
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
# Oracle Text 렉서 (WORLD_LEXER=한/영 혼합, KOREAN_MORPH_LEXER=한국어 정밀)
ORACLE_TEXT_LEXER=WORLD_LEXER
# Oracle 드라이버 모드 (thin=순수파이썬 기본 / thick=Instant Client 필요)
ORACLE_MODE=thin
ORACLE_CLIENT_LIB_DIR=

# 원천 테이블 접근 제어 — 소스 등록·조회·적재를 이 목록의 테이블로만 제한 (쉼표구분, 빈값=제한 없음)
SOURCE_TABLE_ALLOWLIST=

# --- gateway 모드 (사내 게이트웨이 SSO 미들웨어 — JWT 검증을 게이트웨이에 위임) ---
# 앱이 아는 주소는 GATEWAY_AUTH_URL 하나. 응답 필드명이 관례와 다르면 FIELD로 매핑.
#AUTH_MODE=gateway
#GATEWAY_AUTH_URL=https://sso-gw.example.com/verify
#GATEWAY_TOKEN_HEADER=Authorization
#GATEWAY_TOKEN_FIELD=accessToken
#GATEWAY_USER_FIELD=result.userId
#GATEWAY_ROLE_FIELD=result.role
#GATEWAY_CACHE_TTL=60
#GATEWAY_TIMEOUT=5

# --- 도구 서버 기본 등록 (env만으로 등록 — 이후 관리 페이지에서 수정/비활성) ---
# 사내 REST 도구 서버(GET /tools + POST /call)는 TRANSPORT=rest 로.
#MCP_DEFAULT_NAME=datahub
#MCP_DEFAULT_URL=http://사내-도구서버-호스트
#MCP_DEFAULT_TRANSPORT=rest
