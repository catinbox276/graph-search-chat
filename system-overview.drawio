  <diagram id="sys-overview" name="시스템 개요">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 제목 -->
        <mxCell id="title" value="대화 기반 조직 지식그래프 시스템 — 전체 흐름" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="850" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="🟦 시스템 단계&#160;&#160;&#160;🟩 바로 쓸 수 있는 오픈소스/논문&#160;&#160;&#160;🟥 주의할 위험" style="text;html=1;fontSize=13;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="850" height="24" as="geometry" />
        </mxCell>

        <!-- ① 사용자들 -->
        <mxCell id="stage1" value="① 여러 사용자가 MCP 도구로 작업" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="userA" value="사용자 A&#10;(DataHub MCP)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="userB" value="사용자 B&#10;(문서검색 MCP)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="userC" value="사용자 C&#10;(검색 툴)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="150" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- ② 대화 로그 → 그래프 추출 -->
        <mxCell id="stage2" value="② 대화 로그에서 그래프 자동 추출&#10;&#10;LLM이 대화에서 [개념]·[목표]·[접근법]을 뽑아&#10;사용자별 미니 그래프를 만든다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="oss2" value="🟩 Graphiti (29K★, MCP서버 내장)&#10;또는 cognee (온톨로지 커스텀 강점)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="315" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="risk2" value="🟥 위험: 같은 개념을 다르게 뽑음&#10;(dedup 85%면 5단계 경로 신뢰도 44%)&#10;→ 공유 스키마를 먼저 고정할 것" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- 사용자별 그래프 3개 -->
        <mxCell id="gA" value="A의 그래프" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gB" value="B의 그래프" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="465" y="460" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gC" value="C의 그래프" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="460" width="110" height="60" as="geometry" />
        </mxCell>

        <!-- ③ 병합 -->
        <mxCell id="stage3" value="③ 하나의 조직 그래프로 병합&#10;&#10;같은 개념은 자동으로 합쳐지고(dedup)&#10;누가 기여했는지 출처(provenance)는 보존" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="580" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="oss3" value="🟩 Graphiti 단일 group_id 방식&#10;권한 모델: Collaborative Memory 논문&#10;(private/shared 2계층)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="595" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="risk3" value="🟥 위험: 프라이버시 유출&#10;대화 속 이름·내부정보가 타인에게 노출&#10;→ 추출 단계에서 비식별화 필수" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- ④ 가중치 -->
        <mxCell id="stage4" value="④ 자주 나오는 경로에 가중치 ↑&#10;&#10;여러 사용자가 반복해서 지나간 경로(굵은 선)를&#10;우선 노출한다 = 프로세스 마이닝과 동일한 원리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="750" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="oss4" value="🟩 GraphRAG의 degree/커뮤니티 가중&#10;pm4py (프로세스 마이닝 라이브러리)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="765" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="risk4" value="🟥 최대 위험: 피드백 루프&#10;많이 노출 → 더 많이 사용 → 더 노출...&#10;틀린 길도 인기가 되면 굳어짐&#10;→ 빈도 대신 &quot;노출 대비 채택률&quot;로 계산,&#10;일부러 비인기 경로도 일정 비율 노출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="745" width="260" height="120" as="geometry" />
        </mxCell>

