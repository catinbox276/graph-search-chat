        </mxCell>

        <!-- 증거 계층 -->
        <mxCell id="EV" value="증거 계층 (그래프 밖) — 원본 대화 로그&#10;각 노드가 근거로 가리키는 에피소드. 출처(누가·언제) 보존 → 오염 발견 시 롤백 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="800" width="540" height="60" as="geometry" />
        </mxCell>

        <!-- 계층 연결 -->
        <mxCell id="k1" style="endArrow=block;html=1;" edge="1" parent="1" source="L1a" target="L2a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k2" style="endArrow=block;html=1;" edge="1" parent="1" source="L1b" target="L2b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k3" value="12회" style="endArrow=block;html=1;strokeWidth=5;fontSize=11;" edge="1" parent="1" source="L2a" target="L3a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k4" value="2회" style="endArrow=block;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="L2a" target="L3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k5" style="endArrow=block;html=1;strokeWidth=3;" edge="1" parent="1" source="L3a" target="L4a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k6" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="L3b" target="L4b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k7" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="L4a" target="EV"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="k8" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="L4b" target="EV"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 운영 규칙 -->
        <mxCell id="rules" value="운영 규칙&#10;&#10;① 깊이는 4층 고정으로 시작&#10;&#160;&#160;&#160;(오류가 hop마다 곱셈 전파:&#10;&#160;&#160;&#160;85% 정확도 × 5-hop = 44%)&#10;&#10;② 분화는 빈도가 증명할 때만&#10;&#160;&#160;&#160;자주 나오는데 내용이 갈리면&#10;&#160;&#160;&#160;그때 자식 노드로 분리&#10;&#10;③ 저빈도 잎은 부모로 흡수&#10;&#160;&#160;&#160;통행 1~2회 말단은 합쳐서&#10;&#160;&#160;&#160;그래프 비대화 방지&#10;&#10;④ 검색은 2~3 hop 제한&#10;&#160;&#160;&#160;그 이상은 제안 품질 급락" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="120" width="250" height="330" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="★ 3층(접근법)이 &quot;신규 사용자에게 제안하는 경로&quot;의 단위&#10;굵은 테두리 = 가중치 높음 → 우선 노출&#160;&#160;/&#160;&#160;점선 = 저빈도&#160;&#160;/&#160;&#160;보라 = 새로 열린 방향" style="text;html=1;fontSize=13;align=center;fontColor=#333333;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="900" width="800" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="session-gate" name="세션 판정 3갈래 분기">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="gt0" value="어떤 대화를 그래프에 쓸 것인가 — 세션 종료 시 3갈래 분기" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="850" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gt0b" value="모든 대화 ✕ (비용·노이즈)&#160;&#160;&#160;성공만 ✕ (실패도 귀한 신호)&#160;&#160;&#160;→ 완결된 대화를 결과에 따라 다르게 ○" style="text;html=1;fontSize=13;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="850" height="24" as="geometry" />
        </mxCell>

        <!-- 세션 진행 -->
        <mxCell id="gs1" value="대화 세션 진행 중&#10;(실시간으로는 그래프에 쓰지 않음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="475" y="110" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- 세션 종료 -->
        <mxCell id="gs2" value="세션 종료&#10;→ 이 시점에 한 번만 판정 (트리거 기반 추출)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="475" y="220" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- 판정 방법 -->
        <mxCell id="gjudge" value="판정 방법 (우선순위 순)&#10;&#10;① 사용자 명시 확인 (&quot;해결됐어&quot;)&#10;② 태스크 완료 신호 (결과물 생성됨)&#10;③ 둘 다 없으면 LLM 판정&#10;&#160;&#160;&#160;(세션 요약 → &quot;해결됐는가?&quot; 분류)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="300" height="140" as="geometry" />
        </mxCell>

        <!-- 분기 다이아몬드 -->
        <mxCell id="gd" value="목표에&#10;도달했나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="545" y="340" width="160" height="110" as="geometry" />
        </mxCell>

        <!-- 분기 1: 성공 -->
        <mxCell id="gb1" value="✅ 목표 도달 (성공)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="530" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gb1d" value="경로 추출 → 그래프에 기록&#10;+ 양의 가중치&#10;&#10;→ 신규 사용자에게 추천되는 경로" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="600" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- 분기 2: 실패 -->
        <mxCell id="gb2" value="⚠️ 명시적 실패&#10;(&quot;이 방법으론 안 됐다&quot; 확인됨)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="485" y="530" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gb2d" value="경로 추출 → 그래프에 기록&#10;+ 실패 표식 (추천엔 사용 안 함)&#10;&#10;→ &quot;이 길은 막혔었음&quot; 경고용&#10;(ExpeL: 성공-실패 쌍 비교가 통찰의 원천)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="485" y="600" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- 분기 3: 미완결 -->
        <mxCell id="gb3" value="❓ 미완결 / 이탈&#10;(대화가 끊김, 결과 불명)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="530" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gb3d" value="그래프에 쓰지 않음&#10;&#10;원본 로그만 증거 계층에 보관&#10;(나중에 같은 경로가 성공하면 참고 가능)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="600" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- 화살표 -->
        <mxCell id="gf1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="gs1" target="gs2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gf2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="gs2" target="gd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gfj" style="endArrow=open;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="gjudge" target="gd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gf3" value="예" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;fontSize=13;fontStyle=1;" edge="1" parent="1" source="gd" target="gb1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gf4" value="아니오 (확인됨)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=13;fontStyle=1;" edge="1" parent="1" source="gd" target="gb2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gf5" value="불명" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;fontSize=13;fontStyle=1;" edge="1" parent="1" source="gd" target="gb3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 하단 노트 -->
        <mxCell id="gnote" value="💡 이 관문 하나가 세 가지 문제를 동시에 해결&#10;&#10;① 비용 — 전량 추출 대신 트리거 기반 (GraphRAG $33K 사례 회피)&#160;&#160;&#160;&#160;② 노이즈 — 잡담·헤맨 대화가 그래프를 오염시키지 않음&#160;&#160;&#160;&#160;③ 보안 — &quot;검증된 완결 세션만 쓴다&quot; = 메모리 오염(MINJA 98% 주입)의 1차 방어선" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="740" width="970" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
