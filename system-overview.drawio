  <diagram id="schema-4layer" name="4계층 스키마">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t0" value="그래프 4계층 스키마 — 위는 닫고, 아래는 연다" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="850" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t0b" value="🔒 닫힌 층 = 사람이 미리 고정 (병합 안정성)&#160;&#160;&#160;🔓 열린 층 = LLM이 자동 확장 (새 방향 수용)" style="text;html=1;fontSize=13;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="850" height="24" as="geometry" />
        </mxCell>

        <!-- L1 -->
        <mxCell id="L1" value="1층&#10;문제 도메인&#10;&#10;🔒 사람이 고정&#10;(닫힌 목록)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L1a" value="데이터 리니지 파악" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="L1b" value="문서/지식 검색" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="150" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- L2 -->
        <mxCell id="L2" value="2층&#10;목표 / 태스크&#10;&#10;🔒 사람이 시드 제공&#10;+ LLM이 분류" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L2a" value="특정 테이블의&#10;상류 소스 찾기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L2b" value="컬럼 의미 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="310" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- L3 -->
        <mxCell id="L3" value="3층&#10;접근법 ★경로의 핵심&#10;&#10;🔓 LLM이 자동 생성&#10;(열린 목록)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L3a" value="DataHub MCP로&#10;lineage API 조회&#10;(가중치 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=3;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="475" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L3b" value="SQL 로그 직접 분석&#10;(가중치 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="475" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L3new" value="+ 새 접근법&#10;(신규 사용자가 추가)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="475" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- L4 -->
        <mxCell id="L4" value="4층&#10;구체 행동&#10;&#10;🔓 자동 기록&#10;(도구 호출·쿼리)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L4a" value="get_lineage(table_x,&#10;direction=upstream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="300" y="650" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L4b" value="search_docs(&quot;table_x&#10;ETL job&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
