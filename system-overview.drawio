        <!-- ⑤ 신규 사용자 가이드 -->
        <mxCell id="stage5" value="⑤ 신규 사용자에게 방향 제안&#10;&#10;비슷한 문제를 만나면 &quot;다른 사람들은 이 길로&#10;해결했어요&quot;라고 가중치 높은 경로를 안내" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="1130" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="oss5" value="🟩 AWM (Agent Workflow Memory)&#10;AutoGuide — 상황별 가이드라인 추출&#10;※ 이 부분은 직접 구현 필요 (공백 영역)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="1145" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="risk5" value="🟥 위험: 메모리 오염&#10;일반 사용자가 대화만으로 공유 그래프에&#10;가짜 지식 주입 가능 (성공률 98% 실증)&#10;→ 쓰기 전 검증 + 출처별 롤백 설계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
